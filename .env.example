# ============================================================
# AI ROOM DECOR — CONFIGURATION TEMPLATE (.env.example)
# ============================================================
APP_ENV=development
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/ai_room_decor?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/ai_room_decor_test?charset=utf8mb4
DATABASE_SSL_VERIFY=false
DATABASE_SSL_CA=

# Reverse proxy & Rate limiting
TRUSTED_PROXIES=127.0.0.1,localhost
RATE_LIMIT_ENABLED=true

# Storage backend ("local" | "cloudinary")
STORAGE_BACKEND=local
STORAGE_ROOT_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ai_room_decor

JWT_SECRET_KEY=change-this-secret-in-local-env
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PRODUCT_STORAGE_DIR=storage/products
ROOM_STORAGE_DIR=storage/rooms
MAX_ROOM_IMAGE_MB=10

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Development Admin

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ============================================================
# AI QUOTA & COST PROTECTION
# ============================================================
ENABLE_CLOUD_AI=true
GEMINI_DAILY_USER_LIMIT=3
GEMINI_DAILY_SYSTEM_LIMIT=50
CLOUDFLARE_DAILY_USER_LIMIT=1
CLOUDFLARE_DAILY_SYSTEM_LIMIT=10
AI_IN_FLIGHT_TIMEOUT_SECONDS=300

# Vision provider configuration. Do not put real secrets in source control.
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=
GEMINI_API_KEY=
VISION_API_BASE_URL=https://api.openai.com/v1

# Image generation provider configuration. Do not put real secrets in source control.
# Primary: "cloudflare" (generative image-to-image with product reference images).
# Alternatives: "gemini", "openai", or "composite" (deterministic compositor, opt-in only).
# For Gemini image generation, IMAGE_API_KEY may be empty when GEMINI_API_KEY is configured.
IMAGE_PROVIDER=cloudflare
IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_TIMEOUT_SECONDS=300
CLOUDFLARE_IMAGE_MAX_RETRIES=3

# Optional QwenCloud Image editing provider (does not affect Gemini Vision)
# Set IMAGE_PROVIDER=qwencloud and IMAGE_MODEL=qwen-image-2.1-pro to enable.
QWENCLOUD_API_KEY=
QWENCLOUD_API_BASE_URL=https://maas.qwencloudapi.com/api/v1
QWENCLOUD_IMAGE_TIMEOUT_SECONDS=600
GENERATED_DESIGN_STORAGE_DIR=storage/generated-room-designs

# Stock image providers (Phase 10C catalog pilot). Do not put real secrets in source control.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Google Custom Search JSON API (image search). 100 free queries/day, then billed.
# GOOGLE_API_KEY: Google Cloud API key with the "Custom Search API" enabled.
# GOOGLE_CSE_ID: Programmable Search Engine ID (cx) configured to search images
#                across the web. Both are required for the Admin image search.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
