# ============================================================
# AI ROOM DECOR — BACKEND ENVIRONMENT (mẫu)
# Copy file này thành `.env` và điền giá trị thật.
# KHÔNG commit `.env` chứa secret thật lên repository.
# ============================================================

# ---- Database (MariaDB/MySQL) ----
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_room_decor?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_room_decor_test?charset=utf8mb4

# ---- JWT ----
JWT_SECRET_KEY=THAY_BANG_CHUOI_NGAU_NHIEN_IT_NHAT_32_KY_TU
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS: liệt kê origin frontend (cách nhau dấu phẩy) ----
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Lưu trữ ảnh (filesystem) ----
PRODUCT_STORAGE_DIR=storage/products
ROOM_STORAGE_DIR=storage/rooms
GENERATED_DESIGN_STORAGE_DIR=storage/generated-room-designs
MAX_ROOM_IMAGE_MB=10

# ---- Tài khoản admin (seed lúc khởi động) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_MANH
ADMIN_FULL_NAME=AI Room Decor Admin

# ---- Môi trường ----
APP_ENV=development

# ============================================================
# AI VISION — Phân tích ảnh phòng
# ============================================================
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
VISION_API_KEY=
VISION_API_BASE_URL=https://api.openai.com/v1

# ============================================================
# AI IMAGE — Sinh ảnh thiết kế
#   cloudflare : @cf/black-forest-labs/flux-2-dev (khuyến nghị)
#   gemini     : gemini-2.5-flash-image
#   openai     : gpt-image-1
#   composite  : deterministic compositor (không generative, opt-in)
# ============================================================
IMAGE_PROVIDER=cloudflare
IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1

# ---- Cloudflare Workers AI ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_TIMEOUT_SECONDS=300
CLOUDFLARE_IMAGE_MAX_RETRIES=3

# ---- QwenCloud (tùy chọn) ----
QWENCLOUD_API_KEY=
QWENCLOUD_API_BASE_URL=https://maas.qwencloudapi.com/api/v1
QWENCLOUD_IMAGE_TIMEOUT_SECONDS=600

# ---- Stock image providers (tùy chọn, cho admin tìm ảnh sản phẩm) ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
WIKIMEDIA_CONTACT=
