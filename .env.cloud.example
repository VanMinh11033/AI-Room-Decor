# ==============================================================================
# AI ROOM DECOR — CLOUD PRODUCTION ENVIRONMENT TEMPLATE (.env.cloud.example)
# ==============================================================================
# HƯỚNG DẪN: Không đưa mật khẩu hoặc API Key thật vào Git.
# Điền các giá trị này vào phần "Environment Variables" trên Render & Vercel.
# ==============================================================================

# ----- 1. Ứng dụng & Môi trường -----
APP_ENV=production
TRUSTED_PROXIES=127.0.0.1,localhost
RATE_LIMIT_ENABLED=true

# ----- 2. Cơ sở dữ liệu TiDB Cloud Serverless (MySQL Compatible) -----
# Lấy chuỗi kết nối từ TiDB Cloud Console (cổng 4000, bật SSL TLS)
DATABASE_URL=mysql+pymysql://<TIDB_USER>:<TIDB_PASSWORD>@<TIDB_HOST>:4000/ai_room_decor?ssl_verify_cert=true&charset=utf8mb4
DATABASE_SSL_VERIFY=true

# ----- 3. Xác thực JWT -----
# Sinh khóa ngẫu nhiên an toàn bằng lệnh: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_64_character_random_hex_string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- 4. CORS (Cho phép Vercel gọi Render) -----
# Thay https://ai-room-decor.vercel.app bằng domain Vercel thực tế
BACKEND_CORS_ORIGINS=https://ai-room-decor.vercel.app,http://localhost:3000

# ----- 5. Lưu trữ ảnh đám mây Cloudinary Free -----
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
CLOUDINARY_FOLDER=ai_room_decor

# ----- 6. AI Quota & Giới hạn chi phí -----
ENABLE_CLOUD_AI=true
GEMINI_DAILY_USER_LIMIT=3
GEMINI_DAILY_SYSTEM_LIMIT=50
CLOUDFLARE_DAILY_USER_LIMIT=1
CLOUDFLARE_DAILY_SYSTEM_LIMIT=10
AI_IN_FLIGHT_TIMEOUT_SECONDS=300

# ----- 7. AI Vision (Google Gemini API Free Tier) -----
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace_with_google_gemini_api_key

# ----- 8. AI Image Generation (Cloudflare Workers AI FLUX.2) -----
IMAGE_PROVIDER=cloudflare
IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token
CLOUDFLARE_IMAGE_TIMEOUT_SECONDS=95
CLOUDFLARE_IMAGE_MAX_RETRIES=2

# ----- 9. Frontend Vercel Environment (Bắt buộc thiết lập trên Vercel) -----
# Điền URL Render của bạn để Next.js gọi API
NEXT_PUBLIC_API_URL=https://ai-room-decor-api.onrender.com
